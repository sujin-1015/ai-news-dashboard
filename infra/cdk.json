{
  "app": "python app.py",
  "watch": { "include": ["**"], "exclude": ["build", "cdk.out", "**/__pycache__"] },
  "context": {
    "region": "ap-northeast-2",
    "alertEmail": "",
    "budgetLimitsUsd": [1, 5],
    "githubRepo": "sujin-1015/ai-news-dashboard",
    "githubBranch": "main",
    "githubSubPrefix": "repo:sujin-1015@310905106/ai-news-dashboard@1472982399",
    "collectEveryMinutes": 60,
    "windowDays": 7,
    "articleTtlDays": 180,
    "logRetentionDays": 14,
    "geminiModel": "gemini-3.5-flash-lite",
    "geminiKeyParam": "/ai-news/gemini-api-key",
    "chatDailyLimit": 200,
    "chatRateLimitPerSec": 1,
    "chatBurstLimit": 5,

    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true
  }
}
